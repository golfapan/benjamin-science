{
  "name": "benjamin-science",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {"ACCESS_MODE": "public"},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "benjamin-progress",
      "database_id": "f5c01580-de33-4a96-8e39-c462089f2368"
    }
  ]
}
